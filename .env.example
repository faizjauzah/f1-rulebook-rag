# Nothing here is required. Endpoints and models live in config.yaml, and a local
# server ignores the API key. Uncomment a line only if you want to override it.

# Key sent to your local server (default: "lm-studio")
# LOCAL_API_KEY=lm-studio

# Retrieval
# TOP_K=5
# SIMILARITY_THRESHOLD=0.6
# MAX_SOURCE_CHARS=3500

# Ingestion
# PDF_DIRECTORY=PDFs
# MAX_CHUNK_CHARS=800
# CHUNK_OVERLAP_CHARS=120
# MIN_CHUNK_CHARS=200
# MAX_CHUNK_TOKENS=400
# LOCAL_EMBED_BATCH=16
# MAX_EMBED_CHARS=1000

# Embedding prefixes (check your model card). Defaults are for bge-large-en-v1.5;
# setting a variable to "" overrides the default with no prefix.
# EMBED_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
# EMBED_DOC_PREFIX=

# Generation budget
# LLM_MAX_CONTEXT_CHARS=12000
# LLM_MAX_TOKENS=1500

# ChromaDB (Compose sets CHROMA_HOST=chroma and CHROMA_PORT=8000 for the API)
# CHROMA_HOST=localhost
# CHROMA_PORT=8001

# Eval
# EVAL_TIMEOUT=180
